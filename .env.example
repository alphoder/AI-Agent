# =============================================================================
# SpeakCoach — Environment Variables
# =============================================================================
# Copy to .env and fill in. The whole stack runs on free tiers:
# Postgres (local/Neon/Supabase) + Gemini + Google OAuth.

# --- General ---
NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/avatar_platform

# --- JWT (RS256 in prod; any string works in dev → HS256) ---
# Generate: openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#           openssl rsa -pubout -in private.pem -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gemini (sole AI provider) ---
# KEY 1: conversation (Gemini 3 Live) + reports/scoring + body-language vision.
GEMINI_API_KEY=
# KEY 2: ONLY used to redesign a user's own prompt (Gemini 3.1 Flash Lite).
GEMINI_PROMPT_API_KEY=

# --- Service-to-service ---
AI_SERVICE_URL=http://localhost:8000
API_GATEWAY_URL=http://localhost:4000
INTERNAL_API_KEY=dev-internal-key
# Secret for signing short-lived WebSocket tickets (API signs, AI verifies).
# Must be identical in both services. Generate: openssl rand -hex 32
WS_TICKET_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js / Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
