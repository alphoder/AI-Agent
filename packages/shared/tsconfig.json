{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*"],
  "// exclude": "Self-checks are run with tsx and use node builtins; this package targets the browser and has no @types/node, so compiling them here fails the build and would ship them in dist.",
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
